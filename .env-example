PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=mcm
DATABASE_PASSWORD=mcm
DATABASE_SCHEMA=mcm
# Enable SSL for MySQL connection (set to 'true' to enable SSL)
# DATABASE_SSL_ENABLED=false
# Verify server certificate when using SSL (set to 'true' to verify)
# DATABASE_SSL_VERIFY=false
# CA certificate string for MySQL SSL (leave empty for default)
# DATABASE_SSL_CA=

VAULT_ENDPOINT=http://vault.mcm.localhost
VAULT_AUTH_METHOD=APP_ROLE
VAULT_ROLE_ID_FILE=./docker/vault/tmp/role-id
VAULT_ROLE_SECRET_ID_FILE=./docker/vault/tmp/secret-id
VAULT_PKI_CLIENT_ROLE=example.com
VAULT_PKI_SERVER_ROLE=example.com

SWITCH_ID=switch

# Docker Compose configuration
# Uncomment and customize to run multiple instances simultaneously

# Domain for Traefik routing (default: mcm.localhost)
# COMPOSE_DOMAIN=mcm.localhost

# Traefik HTTP port (default: 80)
# TRAEFIK_HTTP_PORT=80

# Traefik dashboard port (default: 8090)
# TRAEFIK_DASHBOARD_PORT=8090

# MySQL host port mapping (default: 3306)
# Use different ports to run multiple instances (e.g., 3307, 3308)
# DATABASE_PORT=3306
